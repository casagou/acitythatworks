    {
      "n": 41,
      "topic": 10,
      "topicName": "A smaller scored Hall",
      "measure": "M65",
      "what": "rotating zero-based reviews",
      "kind": "scored",
      "mark": "Weak",
      "value": 0.5,
      "quote": "I will be a responsible steward of our limited resources and will focus on the core responsibilities of local government: infrastructure, transportation, public safety, affordability, and public transportation systems that work for all.",
      "why": "Agrees with M65's jurisdiction test — is this the City's job — as a goal, with no instrument: no zero-based cycle, no grant threshold, no three-part test, no savings number. Note the tension: M23b's position is that transit is not a municipal decision, and she lists it as a core local responsibility. Not opposition, but flagged.",
      "url": "https://www.karenrothe.ca/",
      "source": "karenrothe.ca",
      "lastmod": null,
      "retrieved": "2026-09-02"
    },
    {
      "n": 42,
      "topic": 10,
      "topicName": "A smaller scored Hall",
      "measure": "M67",
      "what": "quarterly performance dashboard",
      "kind": "scored",
      "mark": "Weak",
      "value": 0.5,
      "quote": "Council has delegated its responsibilities to staff. This has created a lack of transparency, a lack of accountability, and an erosion of public trust.",
      "why": "Agrees with the goal M67 exists to serve — residents able to hold council to account between elections — with no instrument: no dashboard, no KPI set, no publication cadence. Context: \"Perspectives and feelings matter and they need to be backed up by facts and data.\"",
      "url": "https://www.karenrothe.ca/",
      "source": "karenrothe.ca",
      "lastmod": null,
      "retrieved": "2026-09-02"
