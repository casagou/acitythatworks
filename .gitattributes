# core.autocrlf is on for this checkout, and Git decides text-vs-binary by
# sniffing for NUL bytes. That heuristic is right for the PDF today, but a
# silently CRLF-mangled binary is the kind of failure nobody notices until a
# reader downloads a broken file. State it explicitly instead.
*.pdf   binary
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.woff  binary
*.woff2 binary

# Source stays LF in the repository, whatever the working copy uses.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.webmanifest text eol=lf

# Netlify config files have no extension, so they need naming.
_redirects text eol=lf
_headers   text eol=lf
